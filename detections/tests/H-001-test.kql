// Test for hunt H-001. Expected: 2 rows.
//   erik@contoso.com   ["HR-Sync"]     -> normal user changing app credentials (suspicious)
//   admin@contoso.com  ["Backup-App"]  -> likely planned rotation; the analyst confirms
// Must NOT appear: the plain "Update application" change.

let AuditLogs =
    datatable(TimeGenerated:datetime, OperationName:string, Result:string, InitiatedBy:dynamic, TargetResources:dynamic)
    [
        // Compromised user adds a secret to an app -> should show up
        datetime(2026-10-20T09:35:00), "Update application – Certificates and secrets management ", "success",
            dynamic({"user":{"userPrincipalName":"erik@contoso.com"}}),
            dynamic([{"displayName":"HR-Sync"}]),
        // Admin rotates a secret as planned -> also shows up; the analyst judges it
        datetime(2026-10-18T14:00:00), "Add service principal credentials", "success",
            dynamic({"user":{"userPrincipalName":"admin@contoso.com"}}),
            dynamic([{"displayName":"Backup-App"}]),
        // A different change to an app -> should not show up
        datetime(2026-10-20T10:00:00), "Update application", "success",
            dynamic({"user":{"userPrincipalName":"admin@contoso.com"}}),
            dynamic([{"displayName":"HR-Sync"}])
    ];
AuditLogs
| where OperationName has_any ("Add service principal credentials", "Certificates and secrets management")
| where Result == "success"
| extend Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
         App   = tostring(TargetResources[0].displayName)
| summarize Changes = count(), Apps = make_set(App), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by Actor
| sort by LastSeen desc