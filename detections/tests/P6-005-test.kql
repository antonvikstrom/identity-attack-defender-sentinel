// Test for P6-005: security info (MFA) registered from an unfamiliar IP.
// Run in Azure Data Explorer or Sentinel Logs. ref_time is fixed here (10:15); the rule uses now().
// Detection window: 09:15–10:15. Baseline: the 14 days before that.
//
// Expected: exactly 1 row
//   erik@contoso.com  203.0.113.50  KnownIPs ["198.51.100.20"]  -> registration from an IP erik never signed in from (true positive)
//
// Must NOT appear:
//   frida@contoso.com  198.51.100.10  -> her usual IP
//   erik@contoso.com   "User changed default security info"  -> a different operation
//
// Note: the first version used ref_time 10:30, which put erik's 09:25 registration
// outside the window and returned 0 rows. Keep test events well inside the window.

let SigninLogs =
    datatable(TimeGenerated:datetime, UserPrincipalName:string, IPAddress:string, ResultType:string)
    [
        // Baseline: earlier successful sign-ins
        datetime(2026-10-15T08:00:00), "erik@contoso.com",  "198.51.100.20", "0",
        datetime(2026-10-16T09:00:00), "frida@contoso.com", "198.51.100.10", "0"
    ];
let AuditLogs =
    datatable(TimeGenerated:datetime, OperationName:string, Result:string, InitiatedBy:dynamic)
    [
        // Registration from an IP erik has never signed in from -> SHOULD alert
        datetime(2026-10-20T09:25:00), "User registered security info", "success",
            dynamic({"user":{"userPrincipalName":"erik@contoso.com","ipAddress":"203.0.113.50"}}),
        // Registration from frida's usual IP -> no alert
        datetime(2026-10-20T10:00:00), "User registered security info", "success",
            dynamic({"user":{"userPrincipalName":"frida@contoso.com","ipAddress":"198.51.100.10"}}),
        // A different operation -> no alert
        datetime(2026-10-20T10:05:00), "User changed default security info", "success",
            dynamic({"user":{"userPrincipalName":"erik@contoso.com","ipAddress":"203.0.113.50"}})
    ];
let ref_time = datetime(2026-10-20T10:15:00);   // in the real rule: now()
let baseline_period = 14d;
let detection_window = 1h;
let KnownIPs =
    SigninLogs
    | where TimeGenerated between ((ref_time - baseline_period) .. (ref_time - detection_window))
    | where ResultType == "0"
    | summarize KnownIPs = make_set(IPAddress) by UserPrincipalName;
AuditLogs
| where TimeGenerated > ref_time - detection_window
| where OperationName == "User registered security info" and Result == "success"
| extend UserPrincipalName = tostring(InitiatedBy.user.userPrincipalName),
         IPAddress         = tostring(InitiatedBy.user.ipAddress)
| join kind=inner KnownIPs on UserPrincipalName
| where not(set_has_element(KnownIPs, IPAddress))
| project TimeGenerated, UserPrincipalName, IPAddress, KnownIPs